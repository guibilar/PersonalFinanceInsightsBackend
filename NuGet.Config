<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources. Hestia.* (the shared Hestia contracts, T04) comes from GitHub Packages; everything else from nuget.org.
     GitHub Packages needs a token, also for a public package: set HESTIA_PACKAGES_TOKEN (a GitHub token with the
     read:packages scope) and HESTIA_PACKAGES_USER (your GitHub user name) before `dotnet restore`.
     CI sets them from GITHUB_TOKEN; the Docker build gets them as a build secret (see the README). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="hestia" value="https://nuget.pkg.github.com/guibilar/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="hestia">
      <package pattern="Hestia.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <hestia>
      <add key="Username" value="%HESTIA_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%HESTIA_PACKAGES_TOKEN%" />
    </hestia>
  </packageSourceCredentials>
</configuration>
