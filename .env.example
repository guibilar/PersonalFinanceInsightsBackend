# Copy to .env (never committed) and set a real password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=FinanceDb

# The account you sign in with, created on first start. At least 12 characters.
# Change it later from the app; set FINANCE_RESET_PASSWORD=true once to reset a forgotten one.
FINANCE_USERNAME=me
FINANCE_PASSWORD=change-me-to-a-long-passphrase

# Optional: lets scripts and assistants read everything (and change nothing) with
# `Authorization: Bearer <token>`. At least 32 characters: `openssl rand -hex 32`. Leave empty to turn it off.
FINANCE_READONLY_TOKEN=

# Nightly database dumps (docker/backup.sh). The folder is on this machine: copy it somewhere else too.
BACKUP_DIR=./backups
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=14
# Who owns the dumps: your user on this machine (`id -u` and `id -g`). Create the folder first
# (`mkdir -p backups`), or Docker creates it as root and the backup container can't write to it.
BACKUP_UID=1000
BACKUP_GID=1000
